((# Gruppuppgiftsmall (Fas 0.6) — arbetsbladets syskon, men ett papper som
    ligger på ett BORD: namnraderna högst upp, tiden och redovisningsformen i
    klartext, och inga poäng på elevens ark. Formen speglar frontendens
    gruppark (app/web/ui/gruppark.css, blad.js grupphuvud): rubriken ensam,
    metaraden under, instruktionsbandet, sedan uppgifterna.
    Facit ligger på egen sida — det är lärarens, inte gruppens.
    Fast preamble; Jinja-avgränsarna är parentesbaserade. #))
((* set med_grafik = true *))
((* set med_svarsrad = true *))
((* include '_preamble.tex.j2' *))
((* import '_former.tex.j2' as former *))

\begin{document}

\begin{center}
  {\LARGE\bfseries ((( titel )))}\\[2mm]
  ((# Ingen metarad: läraren säger gruppstorlek, tid och redovisningsform själv
     i klassrummet (beslut 2026-08-20). Fälten styr fortfarande namnraderna och
     instruktionsbandet — samma regel som skärmen (blad.js grupphuvud). #))
  {\large Gruppuppgift — ((( kurs )))((* if klass *)) \; · \; ((( klass )))((* endif *))((* if datum *)) \; · \; ((( datum )))((* endif *))}
\end{center}

\vspace{4mm}
((# Namnraderna: en per elev i gruppen, precis som gutopp i webbversionen. #))
((* for _ in range(grupp.elever) *))
\noindent Namn: \rule{0.86\linewidth}{0.4pt}\par\vspace{3mm}
((* endfor *))

\vspace{2mm}
\notisruta{((( grupp.band )))}

\vspace{4mm}
((* for del in delar *))
((* for u in del.uppgifter *))
((# Inga poäng på gruppens ark: det är samtalet som prövas, och en siffra i
    marginalen gör uppgiften till en tävling. Poängen står i facit. #))
\begin{uppgift}{((( u.bokstav )))}{}
((( u.text )))
((* if u.bild_fil *))\par\vspace{2mm}\begin{center}\includegraphics[width=0.72\linewidth,height=90mm,keepaspectratio]{((( u.bild_fil )))}\end{center}((* endif *))
((* if u.figur_tex *))\par\vspace{2mm}\begin{center}((( u.figur_tex )))\end{center}((* endif *))
((( former.kropp(u) )))
((* if u.notis *))\notisruta{((( u.notis )))}((* endif *))
((* if u.har_deluppgifter *))
((* for d in u.deluppgifter *))
\begin{deluppgift}{((( d.bokstav )))}{}
((( d.text )))
((( former.kropp(d) )))
((* if d.notis *))\notisruta{((( d.notis )))}((* endif *))
((# Ifyllnadsraderna ÄR svarsplatsen när de finns: den som skrivit «Ekvation:»
    och «Svar i ord:» har redan svarat, och en svarslinje till under dem är en
    rad ingen vet vad hon ska fylla i. Räkningen görs på lösblad. #))
((* if d.flerval *))((* for alt in d.flerval *))\par\kryssruta\ ((( alt.bokstav ))): ((( alt.text )))((* endfor *))\par\vspace{2mm}((* elif d.svarsfalt *))((( former.falt(d.svarsfalt) )))((* elif d.endast_svar *))((* if d.enhet *))\svarsradmed{}{((( d.enhet )))}((* else *))\svarsrad((* endif *))((* else *))\par\vspace{((( d.utrymme_mm )))mm}((* endif *))
\end{deluppgift}
((* endfor *))
((# Förälderns egna ifyllnadsrader står EFTER deluppgifterna: de är
    svarsplatsen för hela uppgiften, och en svarsplats före frågan är en rad
    ingen vet vad hon ska skriva på. #))
((* if u.svarsfalt *))((( former.falt(u.svarsfalt) )))((* endif *))
((* elif u.flerval *))
((* for alt in u.flerval *))\par\kryssruta\ ((( alt.bokstav ))): ((( alt.text )))((* endfor *))\par\vspace{2mm}
((* elif u.svarsfalt *))((( former.falt(u.svarsfalt) )))
((* elif u.endast_svar *))((* if u.enhet *))\svarsradmed{}{((( u.enhet )))}((* else *))\svarsrad((* endif *))((* else *))\par\vspace{((( u.utrymme_mm )))mm}((* endif *))
\end{uppgift}
((* endfor *))
((* endfor *))

