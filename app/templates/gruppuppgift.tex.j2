\delprovband{Facit och bedömning}
{\small Lärarens ark — delas inte ut. Poängen står vid det steg den delas ut på.}
\vspace{3mm}
((* for del in delar *))
((* for u in del.uppgifter *))
\begin{uppgift}{((( u.bokstav )))}{((( u.poang_str )))}\par
((* if u.har_deluppgifter *))
((* for d in u.deluppgifter *))
((# \par MÅSTE avslutas — utan mellanslaget klistras lösningens första ord fast
    i kommandonamnet: en lösning som börjar med en bokstav blev
    «\parGränsvärdet», ett odefinierat kommando, och HELA gruppuppgiftens facit
    föll. Att det inte syntes förrän nu är för att seedens övriga lösningar
    börjar med matematik ($…$ → \(), och \( avslutar \par på egen hand. #))
\begin{deluppgift}{((( d.bokstav )))}{((( d.poang_str )))}\par ((( d.losning )))\par\textit{((( d.bedomning )))}\end{deluppgift}
((* endfor *))
((* else *))((( u.losning )))\par\textit{((( u.bedomning )))}((* endif *))
\end{uppgift}
((* endfor *))
((* endfor *))

