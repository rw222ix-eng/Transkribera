((# Lösningsförslag till ELEVERNA — lärarens beställning 2026-09-17, kvällen
    efter prov 81: «vi får göra om lösningsförslagen så att de är tydligare, så
    att eleverna verkligen kan läsa ut det. Vi skiter i ett poäng och två poäng
    — vi laddar bara upp hela lösningen, full poäng, hur det ser ut.»

    Det är alltså INTE bedömningsanvisningen (bedomning.tex.j2): ingen
    poängtrappa, inga elevexempel, inga kravgränser. Uppgiften som den stod på
    provet, och under den lösningen steg för steg (exam_spec `utforlig`,
    skriven av exam_gen.losningspass). Saknar en enhet sin utförliga lösning
    står facit (`losning`) där i stället — kort, men rätt.

    Samma typografi som provet, av samma skäl som bedömningen: eleven läser
    det här bredvid sitt eget rättade papper.

    `med_poang` (exam_latex.render_losningsforslag) är poängen i
    högermarginalen. Provet har den; GRUPPUPPGIFTEN har den inte, för gruppens
    eget ark bär inga poäng alls — «en siffra i marginalen gör uppgiften till
    en tävling» (gruppuppgift.tex.j2), och det gäller lika mycket det facit
    som gås igenom på tavlan efteråt. #))
((* set med_grafik = false *))
((* set med_svarsrad = false *))
((* set forlaga = true *))
((* set sidhuvud = kurs ~ ' \\textemdash{} ' ~ titel ~ ' \\textperiodcentered{} Lösningsförslag' *))
((* include '_preamble.tex.j2' *))
((* import '_former.tex.j2' as former *))

((# ══════════ LÖSNINGEN ══════════
    Rubriken «Lösning» och sedan stegen som stycken. En rad i `utforlig` är ett
    steg; en ensam formel sätts centrerad (former.stycken), och svarsraden är
    fet (exam_latex._losningsstycken). #))
((* macro losning(e) *))
\par\vspace{1.5mm}{\small\bfseries\textcolor{ink700}{Lösning}}\par\vspace{1mm}
((* if e.utforlig *))
((( former.stycken(e.utforlig) )))
((* elif e.losning *))
((# Reserven utan utförlig lösning: ett steg per rad, som arbetsbladets
    facit (exam_latex.losning_steg). Utan fältet, på en äldre server, som
    förut. #))
((( e.losning_steg if e.losning_steg is defined else e.losning )))\par
((* endif *))
((* endmacro *))

\begin{document}

\begin{center}
  {\LARGE\bfseries Lösningsförslag}\\[2mm]
  {\large ((( titel ))) \textemdash{} ((( kurs )))((* if datum *)) \enspace\textperiodcentered\enspace ((( datum )))((* endif *))}
\end{center}

\vspace{2mm}
((* if med_poang *))
{\small Så här ser en fullständig lösning ut på varje uppgift. Poängen i
högermarginalen är uppgiftens (E/C/A).}
((* else *))
{\small Så här ser en fullständig lösning ut på varje uppgift.}
((* endif *))

\vspace{4mm}
((* for del in delar *))
((* for u in del.uppgifter *))
\begin{uppgift}{((( u.nummer )))}{((* if med_poang *))((( u.poang_eca )))((* endif *))}\par
{\itshape ((( former.stycken(u.stycken) )))}\par\vspace{2mm}
((* if u.bild_fil *))
\begin{center}
  \includegraphics[width=0.6\textwidth]{((( u.bild_fil )))}
\end{center}
((* endif *))
((* if u.figur_tex *))\par\vspace{2mm}\begin{center}((( u.figur_tex )))\end{center}((* endif *))
((( former.kropp(u) )))
((* if u.har_deluppgifter *))
((* for d in u.deluppgifter *))
\begin{deluppgift}{((( d.bokstav )))}{((* if med_poang *))((( d.poang_eca )))((* endif *))}\par
{\itshape ((( former.stycken(d.stycken) )))}\par\vspace{1mm}
((* if d.bild_fil *))
\begin{center}
  \includegraphics[width=0.6\textwidth]{((( d.bild_fil )))}
\end{center}
((* endif *))
((* if d.figur_tex *))\par\vspace{2mm}\begin{center}((( d.figur_tex )))\end{center}((* endif *))
((( former.kropp(d) )))
((* if d.flerval *)){\small\textbf{Rätt alternativ: ((( d.ratt_bokstav )))}}\par\vspace{1mm}((* endif *))
((( losning(d) )))
\end{deluppgift}
((* endfor *))
((* else *))
((* if u.flerval *)){\small\textbf{Rätt alternativ: ((( u.ratt_bokstav )))}}\par\vspace{1mm}((* endif *))
((( losning(u) )))
((* endif *))
\end{uppgift}
((* endfor *))
((* endfor *))

\end{document}
