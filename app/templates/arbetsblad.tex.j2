((# ══════════ ARBETSBLADET I PROVETS FORM ══════════
    Rickard 2026-10-22: bladen ska se ut som provet, «sett till typsnittet,
    sett till mellanrummet mellan deluppgifter, hur uppgifter skrivs, vart
    bilderna är, hur långa meningarna är». Det enda som skiljer: inget
    försättsblad, inga poängangivelser, och facit följer med.

    Mallen är därför prov.tex.j2 utan försättsbladet. Samma preamble i
    förlagans läge (forlaga = true: exam-klassen, Computer Modern, 25 mm
    marginaler, förlagans luft), samma \question och \part, samma
    kravetikett, samma bildplacering och samma svarsrader. Poängen sätts
    aldrig: \question och \part får inget poängargument, och då står inget i
    marginalen. Uppgiftsvyn är densamma som provets (exam_latex._build_view),
    så en malländring här fungerar också mot en server med äldre Python i
    minnet: allt som läses nedan fanns i vyn innan bladet bytte form, och det
    som kom senare frågas med «is defined».

    Bladet var förut skärmens avritning (blad-bild.js). Den tas inte längre
    emot för arbetsblad (routes_exam, skarmen_galler), så det här ÄR bladets
    PDF. #))
((* set med_grafik = true *))
((* set med_svarsrad = true *))
((* set forlaga = true *))
((# Vändmärket som på provet: bladet har flera sidor, och den som gör en sida
    ska veta att det finns mer. Facit ensamt är lärarens papper och får inget. #))
((* set med_vand = not only_facit *))
((* set sidhuvud = '' *))
((* include '_preamble.tex.j2' *))
((# Inget sidhuvud. Provets huvud säger delen, och det stämmer där för att
    varje del börjar på egen sida. Bladets delar följer på varandra, och
    sidan där Del B börjar hade hetat «Del B» ovanför uppgift 6 och 7. #))
\runningheader{}{}{}
\norunningheadrule
((* import '_former.tex.j2' as former *))

((# Facit i bladfacitets form (Rickard 2026-09-26 och 2026-10-13): svaret i
    ruta, ett steg per rad och «← förklaring» bredvid. Grupperna byggs i
    exam_latex._facit_vy; en äldre vy bär stegen som strängar. #))
((* macro facitgrupp(g, namn) *))
((* if g.svar *))\facitsvar{((* if namn *))((( namn )))\enspace ((* endif *))((( g.svar )))}((* elif namn *))\bedsvar{((( namn )))}((* endif *))
((* for s in g.steg *))
((* if s is string *))
\noindent ((( s )))\par\nopagebreak
((* elif s.figur is defined and s.figur *))
\par\vspace{0.8mm}\noindent\begin{minipage}[c]{((* if s.not *))0.58((* else *))0.98((* endif *))\linewidth}
((( s.figur )))
\end{minipage}((* if s.not *))\hfill\begin{minipage}[c]{0.39\linewidth}\small\hangindent=1.4em\hangafter=1\relax
\textcolor{ink700}{\(\leftarrow\)\enspace ((( s.not )))}\end{minipage}((* endif *))
\par\nopagebreak\vspace{0.8mm}\nopagebreak
((* elif s.not *))
\facitsteg{((( s.rad )))}{((( s.not )))}
((* else *))
\noindent ((( s.rad )))\par\nopagebreak
((* endif *))
((* endfor *))
((* endmacro *))

((# Bladets rubrik i försättsbladets egen sättning: titeln stor och fet, en
    underrad och förlagans 0,8 pt-linje. Försättsbladets övriga rader
    (provtid, betygstabell, namnrader) hör till provet och står inte här. #))
((* macro bladhuvud(underrad) *))
\begin{center}
  {\LARGE\bfseries ((( titel )))}\\[6pt]
  {\large ((( underrad )))((* if klass *)) \textperiodcentered{} ((( klass )))((* endif *))((* if elev *)) \textperiodcentered{} ((( elev )))((* endif *))}
\end{center}

\vspace{4mm}
\hrule height 0.8pt
\vspace{6mm}
((* endmacro *))

