((# Arbetsbladsmall (Fas 5) — som provmallen men utan kravgränser, med
    valfri poängvisning, gott om utrymme och facit på egen sida.
    Fast preamble; Jinja-avgränsarna är parentesbaserade. #))
((* set med_grafik = true *))
((* set med_svarsrad = true *))
((* include '_preamble.tex.j2' *))
((* import '_former.tex.j2' as former *))

\begin{document}

\begin{center}
  {\LARGE\bfseries ((( titel )))}\\[2mm]
  {\large ((* if only_facit *))Facit((* else *))Arbetsblad((* endif *)) — ((( kurs )))((* if klass *)) \; · \; ((( klass )))((* endif *))((* if elev *)) \; · \; ((( elev )))((* endif *))((* if datum *)) \; · \; ((( datum )))((* endif *))}
\end{center}

((# «Separat facit» i planeringen lovar ett lösningsblad läraren kan behålla —
    och då hör uppgifterna inte hemma på det. only_facit släcker elevernas del
    och lämnar facitbandet nedan, som då blir sida ett. Ingen egen mallfil, med
    flit: sattes facit av två mallar skulle de glida isär, och det är precis den
    sortens skillnad ingen upptäcker förrän klassen har papperet i handen. #))
((* if not only_facit *))
\vspace{4mm}
{\small Öva i egen takt — uppgifterna blir svårare längre ner. Facit finns
på sista sidan((* if visa_poang *)); poäng anges som totalpoäng((* endif *)).}

\vspace{4mm}
((* for del in delar *))
((* for u in del.uppgifter *))
((# \par avslutar poäng-raden ENDAST när visa_poang är sant — annars
    finns ingen markör (tomt argument) och uppgiftstexten ska stå kvar på
    samma rad som numret, precis som idag. Ett ovillkorligt \par skulle
    flytta ned ALL text ett steg även när ingen markör renderas.
    De två grenarna skrivs som HELA separata \begin{uppgift}-rader (inte
    \par inuti en villkorstagg på samma rad som (* endif *)) — annars äter
    trim_blocks radbrytningen efter taggen och \par glider ihop med
    uppgiftstextens första ord till en odefinierad kontrollsekvens
    (samma fälla som tidigare kraschade prov.tex.j2/bedomning.tex.j2). #))
((* if visa_poang *))
\begin{uppgift}{((( u.nummer )))}{((( u.poang_str )))}\par
((* else *))
\begin{uppgift}{((( u.nummer )))}{}
((* endif *))
((( u.text )))
((* if u.bild_fil *))\par\vspace{2mm}\begin{center}\includegraphics[width=0.72\linewidth,height=90mm,keepaspectratio]{((( u.bild_fil )))}\end{center}((* endif *))
((* if u.figur_tex *))\par\vspace{2mm}\begin{center}((( u.figur_tex )))\end{center}((* endif *))
((( former.kropp(u) )))
((* if u.notis *))\notisruta{((( u.notis )))}((* endif *))
((* if u.har_deluppgifter *))
((* for d in u.deluppgifter *))
((# Villkorligt \par som top-nivåns uppgift: markör → \par direkt efter;
    tom markör (visa_poang=False) → INGET \par (annars trycks texten ned). #))
((* if visa_poang *))
\begin{deluppgift}{((( d.bokstav )))}{((( d.poang_str )))}\par
((* else *))
\begin{deluppgift}{((( d.bokstav )))}{}
((* endif *))
((( d.text )))
((( former.kropp(d) )))
((* if d.notis *))\notisruta{((( d.notis )))}((* endif *))
((* if d.flerval *))((* for alt in d.flerval *))\par\kryssruta\ ((( alt.bokstav ))): ((( alt.text )))((* endfor *))\par\vspace{2mm}((* elif d.svarsfalt *))((( former.falt(d.svarsfalt) )))((* elif d.endast_svar *))((* if d.enhet *))\svarsradmed{}{((( d.enhet )))}((* else *))\svarsrad((* endif *))((* else *))\par\vspace{((( d.utrymme_mm )))mm}((* endif *))
\end{deluppgift}
((* endfor *))
((# Förälderns egna ifyllnadsrader står EFTER deluppgifterna: de är
    svarsplatsen för hela uppgiften, och en svarsplats före frågan är en rad
    ingen vet vad hon ska skriva på. #))
((* if u.svarsfalt *))((( former.falt(u.svarsfalt) )))((* endif *))
((* elif u.flerval *))
((* for alt in u.flerval *))\par\kryssruta\ ((( alt.bokstav ))): ((( alt.text )))((* endfor *))\par\vspace{2mm}
((* elif u.svarsfalt *))((( former.falt(u.svarsfalt) )))((* elif u.endast_svar *))((* if u.enhet *))\svarsradmed{}{((( u.enhet )))}((* else *))\svarsrad((* endif *))((* else *))\par\vspace{((( u.utrymme_mm )))mm}((* endif *))
\end{uppgift}
((* endfor *))
((* endfor *))

\newpage
((* endif *))
\delprovband{Facit}
((* for del in delar *))
((* for u in del.uppgifter *))
\begin{uppgift}{((( u.nummer )))}{}
((* if u.har_deluppgifter *))
((* for d in u.deluppgifter *))
\begin{deluppgift}{((( d.bokstav )))}{}((( d.losning )))\end{deluppgift}
((* endfor *))
((* else *))((( u.losning )))((* endif *))
\end{uppgift}
((* endfor *))
((* endfor *))

\end{document}
