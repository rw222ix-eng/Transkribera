((# Bedömningsanvisning (Fas 4) — eget dokument för lärarens rättning.
    Fast preamble; se _preamble.tex.j2. #))
((* set med_grafik = false *))
((* set med_svarsrad = false *))
((# SAMMA TYPOGRAFI SOM PROVET. Bedömningsanvisningen läses BREDVID elevens
    papper när läraren rättar — samma uppgift, samma nummer, samma indrag. Var
    de satta i två typsnitt med två uppgiftsrytmer fick hon leta efter uppgift
    7 i två olika layouter samtidigt. #))
((* set forlaga = true *))
((# Ingen figur i anvisningen sedan 2026-09-23: uppgiftstexten och dess
    figur står på provet, inte här. Utan tikz slipper pappret buntens
    tyngsta paket (pgfplots) och en kompilering som kan falla offline. #))
((* set med_tikz = false *))
((# DUBBLA BAKSTRECK I EN JINJA-STRÄNG. Jinjas lexer tolkar strängliteralen
    som Python gör: '\textemdash{}' blir TAB + «extemdash{}», och sidhuvudet
    stod på det skarpa provets bedömningsanvisning som «Matematik 1c
    extemdash Potenser extperiodcentered Bedömningsanvisning». Kommandona i
    mallens BRÖDTEXT (utanför ((* … *))) rörs inte — det är bara de här
    literalerna som behöver dubbleras. #))
((* set sidhuvud = kurs ~ ' \\textperiodcentered{} ' ~ titel ~ ' \\textperiodcentered{} Bedömningsanvisning' *))
((* include '_preamble.tex.j2' *))

((# ══════════ NATIONELLA PROVETS FORM ══════════
    Lärarens dom 2026-09-23: «Hela bedömningsanvisningen skulle vi kunna bygga
    mycket tydligare … lik det som finns på nationella proven. För just nu
    känns det som att det är väldigt mycket text och det är svårt för mig att
    rätta snabbt.» Hon valde PRIM-gruppens form (NP 1c vt22):

      20.  x = 6
           Förenklar vänsterled genom att multiplicera parenteserna.   +C
           Lösning med korrekt svar.                                   +C
           (0/2/0)

    Per uppgift, och per deluppgift när den bär poäng: svaret i fetstil och en
    rad per poäng med märket i poängspalten.
    Lärarens dom 2026-09-26: enhetens poäng sist, «(0/0/1)», behövs inte. Den
    sa samma sak som märkena en gång till, och den står inte längre här.
    Uppgiftstexten står INTE här (den har hon på provet bredvid sig), inte
    heller lösningsgången (den står i lösningsförslaget) eller förmågans namn.
    Allt det var text hon fick läsa förbi. Raderna byggs i exam_latex
    (_svarsrad, _bedomning_rader), och skärmen bygger samma rader
    (app/web/ui/blad-bygg.js). #))
((* macro enhet(e, namn) *))
((* if namn or e.svar *))
\bedsvar{((* if namn *))((( namn )))\enspace ((* endif *))((( e.svar )))}
((* endif *))
((* for r in e.bedomning_rader *))
\bedkrav{((( r.krav )))}{((( r.marke )))}
((* endfor *))
((* endmacro *))

((# UPPGIFTERNA TÄTARE ÄN PÅ PROVET. Förlagans luft mellan två uppgifter
    (\pfuppgluft, 22,6 pt) är till för elevens läsning av en fråga i taget.
    Här delar en linje uppgifterna, som i NP:s tabell, och luften på var sida
    om den räcker. Längden sätts om bara i det här dokumentet. #))
\setlength{\pfuppgluft}{0pt}

\begin{document}

\begin{center}
  {\LARGE\bfseries Bedömningsanvisning}\\[2mm]
((# Tankstreck och punkt som KOMMANDON: Computer Modern har inga glyfer på
    U+2014/U+00B7, och tecknen försvinner (eller blir «ů») rakt av. #))
  {\large ((( titel ))) \enspace\textperiodcentered\enspace ((( kurs )))((* if datum *)) \enspace\textperiodcentered\enspace ((( datum )))((* endif *))}
\end{center}

\vspace{4mm}
((# Bara de gränser provet kan dela ut (exam_spec.betygsrader): ett prov
    utan C- och A-poäng har ingen C-gräns att rätta mot. #))
((# Bara totalpoäng: betyget sätts på summan och ingenting annat
    (exam_spec.KRAV_DEFAULT). Uppgifternas (E/C/A) står kvar på raderna,
    det är poängens nivå, inte ett krav för betyget. #))
{\small Poäng anges som (E/C/A). Kravgränser: E minst ((( granser.E.minst )))((* if 'C' in granser.get('betyg', ['E', 'C', 'A']) *)),
C minst ((( granser.C.minst )))((* endif *))((* if 'A' in granser.get('betyg', ['E', 'C', 'A']) *)),
A minst ((( granser.A.minst )))((* endif *)).
Totalt ((( granser.total ))) poäng.}
((# EN GÅNG, i inledningen (lärarens dom 2026-09-23). Notisen stod förut
    under varje uppgift som hade elevexempel, alltså under nästan alla, och
    det var just den sortens upprepade text hon ville bort ifrån. Bara när
    det finns ett avsnitt att hänvisa till. #))
((* if elevavsnitt *))
\par{\small Bedömda elevlösningar står sist i häftet.}
((* endif *))

\vspace{2mm}
((# Linjen står FÖRE varje uppgift utom den första: en linje efter den
    sista hade sett ut som en summering. #))
((* set ns = namespace(forsta=true) *))
((* for del in delar *))
((* for u in del.uppgifter *))
((* if not ns.forsta *))
\bedlinje
((* endif *))
((* set ns.forsta = false *))
((# Tomt poängargument: högermarginalen hör till märkena. #))
\begin{uppgift}{((( u.nummer )))}{}
((* if u.har_deluppgifter *))
((# \penalty0: sidan får brytas mellan två deluppgifter, aldrig inne i en.
    Förut var trippelraden brytpunkten; varje \bedkrav slutar med
    \nopagebreak, och utan straffet här blev hela uppgiften ett block. #))
((* for d in u.deluppgifter *))
((* if not loop.first *))\penalty0\vspace{1.5mm}
((* endif *))
((( enhet(d, d.delnamn) )))
((* endfor *))
((* else *))
((( enhet(u, '') )))
((* endif *))
\end{uppgift}
((* endfor *))
((* endfor *))

((# ══════════ BEDÖMDA ELEVLÖSNINGAR ══════════
    Eget avsnitt sist i häftet, som i NP (lärarens dom 2026-09-23). Förut stod
    de under varje uppgift, en rad per lägre poängsteg, och gjorde tabellen
    till en halv sida per uppgift. Per uppgift: elevens rader, poängen de ges
    och kommentaren (\bedelev).

    Raderna kommer ur bedömningspasset (exam_gen.bedomningspass), som är
    fail-open per uppgift: föll anropet saknas uppgiften här, och ett papper
    utan några elevexempel får inget avsnitt alls. Eleven ser dem aldrig, det
    här är lärarens papper. #))
((* if elevavsnitt *))
\clearpage
{\large\bfseries Bedömda elevlösningar}\par
\vspace{2mm}
((* for u in elevavsnitt *))
((* if not loop.first *))
\bedlinje
((* endif *))
((# PER DELUPPGIFT, MED PILAR (lärarens dom 2026-09-26): en grupp per
    deluppgift med luft emellan, elevens rader med noten vid raden («← +C
    korrekt ekvation», «← byter inte tecken»), och sist poängen i ord, «0
    poäng» eller «+1 C», med kommentaren som motiverar dem. Förut stod a), b)
    och c) i samma lösning under «0/0/0» och en gemensam dom. #))
\begin{uppgift}{((( u.nummer )))}{}
((* for g in u.elevexempel *))
((* if not loop.first *))\bedelevgruppluft
((* endif *))
((* if g.namn *))\bedelevdel{((( g.namn )))}
((* endif *))
((* for e in g.exempel *))
((* if not loop.first *))\bedskilj
((* endif *))
((* for r in e.rader *))
\bedelevrad{((( r.rad )))}{((* if r.slag == 'plus' *))\bedelevplus{((( r.marke )))}{((( r.not )))}((* elif r.slag == 'fel' *))\bedelevfel{((( r.not )))}((* endif *))}
((* endfor *))
\bedelevpoang{((( e.poang )))}{((( e.kommentar )))}
((* endfor *))
((* endfor *))
\end{uppgift}
((* endfor *))
((* endif *))

\end{document}
