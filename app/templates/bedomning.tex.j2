((# Bedömningsanvisning (Fas 4) — eget dokument för lärarens rättning.
    Fast preamble; se _preamble.tex.j2. #))
((* set med_grafik = false *))
((* set med_svarsrad = false *))
((# SAMMA TYPOGRAFI SOM PROVET. Bedömningsanvisningen läses BREDVID elevens
    papper när läraren rättar — samma uppgift, samma nummer, samma indrag. Var
    de satta i två typsnitt med två uppgiftsrytmer fick hon leta efter uppgift
    7 i två olika layouter samtidigt. #))
((* set forlaga = true *))
((* set sidhuvud = kurs ~ ' \textemdash{} ' ~ titel ~ ' \textperiodcentered{} Bedömningsanvisning' *))
((* include '_preamble.tex.j2' *))
((* import '_former.tex.j2' as former *))

((# ══════════ POÄNGTRAPPAN ══════════
    Nationella provets form (Ma 1c vt22, Ma 2c vt22): kriteriet till vänster,
    nivån i högermarginalen, EN RAD PER POÄNG — så att 1 p, 2 p, 3 p syns som
    en trappa och läraren vet vilket steg elevens papper nådde. Raderna delas
    i Python (exam_latex._bedomning_rader, som läser exam_spec.bedomningsrader
    och därför också klarar de gamla dokumentens enradiga kommaform).

    Utan rader — ett tomt fält på en förälder med deluppgifter — trycks
    ingenting alls; rubriken «Bedömning:» utan innehåll var en rad att läsa
    förbi. #))
((* macro bedomning(u) *))
((* if u.bedomning_rader *))
{\small\textbf{Bedömning:}}\par\vspace{0.5mm}
((* for r in u.bedomning_rader *))
((* if r.niva *))\bedsteg{((( r.krav )))}{((( r.niva )))}
((* else *)){\small\itshape ((( r.krav )))}\par
((* endif *))
((* endfor *))
((* endif *))
((* endmacro *))

\begin{document}

\begin{center}
  {\LARGE\bfseries Bedömningsanvisning}\\[2mm]
((# Tankstreck och punkt som KOMMANDON: Computer Modern har inga glyfer på
    U+2014/U+00B7, och tecknen försvinner (eller blir «ů») rakt av. #))
  {\large ((( titel ))) \textemdash{} ((( kurs )))((* if datum *)) \enspace\textperiodcentered\enspace ((( datum )))((* endif *))}
\end{center}

\vspace{4mm}
{\small Poäng anges som (E/C/A). Kravgränser: E minst ((( granser.E.minst ))),
C minst ((( granser.C.minst ))) varav ((( granser.C.varav_ca ))) C/A,
A minst ((( granser.A.minst ))) varav ((( granser.A.varav_a ))) A \textemdash{}
av totalt ((( granser.total ))) poäng.}

\vspace{4mm}
((* for del in delar *))
((* for u in del.uppgifter *))
((# \par avslutar ALLTID poäng-raden här — annars flyter \poangs \hfill in
    i förmågenamnets stycke och poängen hamnar inline i stället för i
    högermarginalen (jfr prov.tex.j2 och app/templates/_preamble.tex.j2). #))
\begin{uppgift}{((( u.nummer )))}{((( u.poang_eca )))}\par
((* if not u.har_deluppgifter *)){\small\textcolor{ink500}{((( u.formaga_namn )))}}\par\vspace{1mm}((* endif *))
((# UPPGIFTSTEXTEN STÖRRE ÄN SVARET, och kursiv. Lärarens dom 2026-08-23:
    «i lösningsförslaget ska uppgiftstexten vara kursiv och något större,
    svaret mindre i rak stil» — hon läser frågan först och svaret sedan, och
    graderna stod tvärtom. Samma ordning på skärmen (app/web/ui/losning.css),
    för PDF:en ska vara skärmtrogen. #))
{\itshape ((( u.text )))}\par\vspace{2mm}
((* if u.bild_fil *)){\small Uppgiften har en bild: ((( u.bild_fil )))}\par\vspace{1mm}((* endif *))
((* if u.figur_tex *))\par\vspace{2mm}\begin{center}((( u.figur_tex )))\end{center}((* endif *))
((( former.kropp(u) )))
((* if u.har_deluppgifter *))
((* for d in u.deluppgifter *))
\begin{deluppgift}{((( d.bokstav )))}{((( d.poang_eca )))}\par
{\small\textcolor{ink500}{((( d.formaga_namn )))}}\par\vspace{1mm}
{\itshape ((( d.text )))}\par\vspace{1mm}
((( former.kropp(d) )))
((* if d.flerval *)){\small\textbf{Rätt: ((( d.ratt_bokstav )))}}\par\vspace{1mm}((* endif *))
{\small\textbf{Lösningsförslag:} ((( d.losning )))}\par\vspace{1mm}
((( bedomning(d) )))
\end{deluppgift}
((* endfor *))
((* else *))
((* if u.flerval *)){\small\textbf{Rätt: ((( u.ratt_bokstav )))}}\par\vspace{1mm}((* endif *))
{\small\textbf{Lösningsförslag:} ((( u.losning )))}\par\vspace{1mm}
((( bedomning(u) )))
((* endif *))
((# Kommenterade elevlösningar (förlagans lo4): samma uppgift löst två eller
    tre gånger, i stigande ordning, med domen INNE i det parti den gäller. Det
    är gränsen mellan poängen som är svår att dra, och den syns bara när man
    ser lösningarna bredvid varandra. Står bara här — eleven ser dem aldrig. #))
((* for e in u.elevlosningar *))
\par\vspace{3mm}\noindent\textbf{((( e.etikett )))} \textemdash{} ((( e.poang ))) p
((* for pa in e.partier *))
\begin{elevparti}{((* if pa.poang *))+((( pa.poang ))) p((* else *))0 p((* endif *))}
((# \par MÅSTE avslutas, precis som i gruppuppgift.tex.j2: utan mellanslaget
    klistras NÄSTA rads första ord fast i kommandonamnet. Lärarens skarpa
    1a-prov gav «\parTanken», ett odefinierat kommando, och HELA
    bedömningsanvisningen föll — provet fick sin PDF, anvisningen ingen.
    Att det inte syntes förr är att elevlösningarnas rader oftast börjar med
    matematik ($…$ → \(), och \( avslutar \par på egen hand. #))
((* for r in pa.rader *))((( r )))\par ((* endfor *))
((# «Kommentar:» som i NP:s bedömda elevlösningar — domen ska säga vilken rad
    i trappan partiet fick och varför inte nästa, och etiketten är det som
    gör den till en kommentar och inte en till lösningsrad. #))
{\small\itshape\textbf{Kommentar:} ((( pa.dom )))}
\end{elevparti}
((* endfor *))
((* endfor *))
\end{uppgift}
((* endfor *))
((* endfor *))

\end{document}
