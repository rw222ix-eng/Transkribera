((# Bedömningsanvisning (Fas 4) — eget dokument för lärarens rättning.
    Fast preamble; se _preamble.tex.j2. #))
((* set med_grafik = false *))
((* set med_svarsrad = false *))
((# SAMMA TYPOGRAFI SOM PROVET. Bedömningsanvisningen läses BREDVID elevens
    papper när läraren rättar — samma uppgift, samma nummer, samma indrag. Var
    de satta i två typsnitt med två uppgiftsrytmer fick hon leta efter uppgift
    7 i två olika layouter samtidigt. #))
((* set forlaga = true *))
((# DUBBLA BAKSTRECK I EN JINJA-STRÄNG. Jinjas lexer tolkar strängliteralen
    som Python gör: '\textemdash{}' blir TAB + «extemdash{}», och sidhuvudet
    stod på det skarpa provets bedömningsanvisning som «Matematik 1c
    extemdash Potenser extperiodcentered Bedömningsanvisning». Kommandona i
    mallens BRÖDTEXT (utanför ((* … *))) rörs inte — det är bara de här
    literalerna som behöver dubbleras. #))
((* set sidhuvud = kurs ~ ' \\textemdash{} ' ~ titel ~ ' \\textperiodcentered{} Bedömningsanvisning' *))
((* include '_preamble.tex.j2' *))
((* import '_former.tex.j2' as former *))

((# ══════════ POÄNGTRAPPAN ══════════
    Nationella provets form (Ma 1c vt22, Ma 2c vt22): kriteriet till vänster,
    nivån i högermarginalen, EN RAD PER POÄNG — så att 1 p, 2 p, 3 p syns som
    en trappa och läraren vet vilket steg elevens papper nådde. Raderna delas
    i Python (exam_latex._bedomning_rader, som läser exam_spec.bedomningsrader
    och därför också klarar de gamla dokumentens enradiga kommaform).

    Trappan står i bedömningstabellens HÖGERSPALT (\bedrad) — hel på
    facitraden, och bara de steg lösningen fick på en elevrad. #))
((* macro trappa(rader) *))
((* for r in rader *))
((* if r.niva *))\bedsteg{((( r.krav )))}{((( r.niva )))}
((* else *)){\small\itshape ((( r.krav )))}\par
((* endif *))
((* endfor *))
((* endmacro *))

((# ══════════ FACITRADEN ══════════
    Tabellens översta rad, en per poängbärande enhet: lösningen till vänster,
    hela trappan till höger. Etiketten säger vad raden ÄR — «Facit · full
    pott» — så att elevraderna under den läses som det de är, papper som inte
    nådde ända fram.

    Utan lösning OCH utan trappa trycks ingenting: en förälder med
    deluppgifter bär varken det ena eller det andra, och en tom rad läses som
    ett fel i pappret i stället för som en lucka i underlaget. #))
((* macro facitrad(u, etikett) *))
((* if u.losning or u.bedomning_rader *))
\bedrad{((( etikett )))}{((* if u.losning *)){\small ((( u.losning )))}((* endif *))}{((( trappa(u.bedomning_rader) )))}
((* endif *))
((* endmacro *))

((# ══════════ ELEVRADERNA ══════════
    En rad per LÄGRE poängsteg — 0 p, 1 p, 2 p … — med elevens papper till
    vänster och de trappsteg lösningen fick till höger, följt av det korta
    skälet till att den inte fick nästa. Full pott står som facitraden ovan och
    skrivs aldrig som elevlösning.

    Raderna kommer ur bedömningspasset (exam_gen.bedomningspass), som är
    fail-open per uppgift: föll anropet står bara facitraden här, och det är
    med flit — ett papper utan elevexempel är fortfarande en anvisning man kan
    rätta efter. #))
((* macro elevrad(e) *))
\bedskilj
((# \par MÅSTE avslutas med ett mellanslag, precis som i gruppuppgift.tex.j2:
    utan det klistras NÄSTA rads första ord fast i kommandonamnet. Lärarens
    skarpa 1a-prov gav «\parTanken», ett odefinierat kommando, och HELA
    bedömningsanvisningen föll — provet fick sin PDF, anvisningen ingen. Att
    det inte syntes förr är att elevlösningarnas rader oftast börjar med
    matematik ($…$ → \(), och \( avslutar \par på egen hand. #))
\bedrad{((( e.etikett )))}{((* for r in e.rader *))((( r )))\par ((* endfor *))}{((* if e.utan *)){\small\bfseries Inga poäng}\par ((* else *))((( trappa(e.trappa) )))((* endif *))((* if e.kommentar *))\par\vspace{1mm}{\small ((( e.kommentar )))}((* endif *))}
((* endmacro *))

\begin{document}

\begin{center}
  {\LARGE\bfseries Bedömningsanvisning}\\[2mm]
((# Tankstreck och punkt som KOMMANDON: Computer Modern har inga glyfer på
    U+2014/U+00B7, och tecknen försvinner (eller blir «ů») rakt av. #))
  {\large ((( titel ))) \textemdash{} ((( kurs )))((* if datum *)) \enspace\textperiodcentered\enspace ((( datum )))((* endif *))}
\end{center}

\vspace{4mm}
{\small Poäng anges som (E/C/A). Kravgränser: E minst ((( granser.E.minst ))),
C minst ((( granser.C.minst ))) varav ((( granser.C.varav_ca ))) C/A,
A minst ((( granser.A.minst ))) varav ((( granser.A.varav_a ))) A \textemdash{}
av totalt ((( granser.total ))) poäng.}

\vspace{4mm}
((* for del in delar *))
((* for u in del.uppgifter *))
((# \par avslutar ALLTID poäng-raden här — annars flyter \poangs \hfill in
    i förmågenamnets stycke och poängen hamnar inline i stället för i
    högermarginalen (jfr prov.tex.j2 och app/templates/_preamble.tex.j2). #))
\begin{uppgift}{((( u.nummer )))}{((( u.poang_eca )))}\par
((* if not u.har_deluppgifter *)){\small\textcolor{ink500}{((( u.formaga_namn )))}}\par\vspace{1mm}((* endif *))
((# UPPGIFTSTEXTEN STÖRRE ÄN SVARET, och kursiv. Lärarens dom 2026-08-23:
    «i lösningsförslaget ska uppgiftstexten vara kursiv och något större,
    svaret mindre i rak stil» — hon läser frågan först och svaret sedan, och
    graderna stod tvärtom. Samma ordning på skärmen (app/web/ui/losning.css),
    för PDF:en ska vara skärmtrogen. #))
{\itshape ((( u.text )))}\par\vspace{2mm}
((* if u.bild_fil *)){\small Uppgiften har en bild: ((( u.bild_fil )))}\par\vspace{1mm}((* endif *))
((* if u.figur_tex *))\par\vspace{2mm}\begin{center}((( u.figur_tex )))\end{center}((* endif *))
((( former.kropp(u) )))
((* if u.har_deluppgifter *))
((* for d in u.deluppgifter *))
\begin{deluppgift}{((( d.bokstav )))}{((( d.poang_eca )))}\par
{\small\textcolor{ink500}{((( d.formaga_namn )))}}\par\vspace{1mm}
{\itshape ((( d.text )))}\par\vspace{1mm}
((( former.kropp(d) )))
((* if d.flerval *)){\small\textbf{Rätt: ((( d.ratt_bokstav )))}}\par\vspace{1mm}((* endif *))
((# MITTPUNKTEN SOM PÅ SKÄRMEN — men i \normalfont. Den ligger i TS1, och
    etiketten är FET: «Font TS1/lmr/bx/n/10.95 not loadable» tog hela
    bedömningsanvisningen med sig första gången. Samma vakt som escapningen
    lägger runt modellens egna TS1-tecken (app/exam_latex._LATEX_SPECIALS);
    mallens egna måste bära den själva. #))
((( facitrad(d, 'Facit ' ~ d.bokstav ~ ') {\\normalfont\\textperiodcentered} full pott') )))
\end{deluppgift}
((* endfor *))
((* else *))
((* if u.flerval *)){\small\textbf{Rätt: ((( u.ratt_bokstav )))}}\par\vspace{1mm}((* endif *))
((( facitrad(u, 'Facit {\\normalfont\\textperiodcentered} full pott') )))
((* endif *))
((# Elevraderna sist i uppgiftens tabell, under facitraden (eller under alla
    deluppgifternas facitrader). Eleven ser dem aldrig — det här är lärarens
    papper. #))
((* for e in u.elevrader *))((( elevrad(e) )))((* endfor *))
\end{uppgift}
((* endfor *))
((* endfor *))

\end{document}
