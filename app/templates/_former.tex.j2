((# ══════════ DE FEM FORMERNA ══════════
    Datatabellen, kryssruteraden, stegtabellen och svarsraden med enhet — samma
    former som på skärmarket (blad-bygg.js), satta för papper. De står här som
    makron i stället för fyra gånger i prov/arbetsblad/gruppuppgift/bedömning:
    en form som sätts på fyra ställen glider isär på tre av dem.

    Anropas med uppgiftsvyn (u eller d) — samma nycklar för löv och deluppgift
    (exam_latex._enhet_vy). Elevlösningarna hör bara till bedömningen och står
    därför i den mallen. #))

((# Datatabellen: mätvärdena uppgiften bygger på. Rutnätet ritas helt — en
    tabell ska gå att läsa i båda riktningar. #))
((* macro tabell(t) *))
((* if t *))\par\vspace{2mm}
{\small\noindent\begin{tabular}{((( t.spec )))}\hline
((* for r in t.rubriker *))\tabrubrik{((( r )))}((* if not loop.last *)) & ((* endif *))((* endfor *)) \\ \hline
((* for rad in t.rader *))((* for c in rad *))((( c )))((* if not loop.last *)) & ((* endif *))((* endfor *)) \\ \hline
((* endfor *))\end{tabular}}\par\vspace{2mm}
((* endif *))
((* endmacro *))

((# Kryssruteraden: en rad att fylla i, inte en flervalsfråga. På lärarens
    papper är det rätta valet fetstilt; på elevens står rutorna tomma. #))
((* macro rutor(r) *))
((* if r *))\svarsrutor{((( r.etikett )))}{((* for v in r.val *))((* if v.ratt *))\textbf{\svarsruteval{((( v.text )))}}((* else *))\svarsruteval{((( v.text )))}((* endif *))((* endfor *))}
((* endif *))
((* endmacro *))

((# Stegtabellen: en färdig lösning rad för rad, och en kryssrutekolumn där
    eleven markerar det FÖRSTA felet. Vilket steget är står bara på lärarens
    papper (exam_latex bygger vyn med facit=True bara för bedömningen). #))
((* macro steg(s) *))
((* if s *))\par\vspace{2mm}
{\small\noindent\begin{tabularx}{\linewidth}{((( s.spec )))}\hline
\tabrubrik{Steg} ((* for k in s.kolumner *))& \tabrubrik{((( k )))} ((* endfor *))& \tabrubrik{Fel} \\ \hline
((* for rad in s.steg *))((( rad.nr ))) ((* for c in rad.celler *))& ((( c ))) ((* endfor *))& ((* if rad.fel *))\textbf{X}((* else *))\kryssruta((* endif *)) \\ \hline
((* endfor *))\end{tabularx}}\par\vspace{2mm}
((* if s.forsta_fel *))\par{\small\itshape Första felet står i steg ((( s.forsta_fel ))).}\par((* endif *))
((* endif *))
((* endmacro *))

((# Ifyllnadsraderna: en namngiven rad per beslut eleven ska skriva ner
    («Ekvation: ……», «Svar i ord: ……»). De ERSÄTTER svarsraden — den som fyller
    i namngivna rader har redan skrivit sitt svar — och därför frågar mallarna
    på u.svarsfalt innan de sätter ut sin egen svarsrad. #))
((* macro falt(f) *))
((* if f *))((* for etikett in f *))\svarsfaltrad{((( etikett )))}((* endfor *))\par\vspace{1mm}
((* endif *))
((* endmacro *))

((# Allt som hör till uppgiftens KROPP, i den ordning eleven läser det:
    tabellen (data att räkna på), stegtabellen (lösningen att granska) och
    kryssruteraden (svaret att kryssa).

    Ifyllnadsraderna står INTE här. De är svarsplatsen, och svarsplatsen kommer
    efter frågan — på en uppgift med deluppgifter alltså efter a) och b), inte
    inklämd mellan stammen och dem. Mallarna sätter dem därför själva, där
    svarsraden annars hade stått. Första skarpa inspelningen visade varför:
    modellen lade fälten på FÖRÄLDERN, och «Valt värde på c:» hamnade före den
    deluppgift som ber om värdet. #))
((* macro kropp(u) *))
((( tabell(u.tabell) )))((( steg(u.stegtabell) )))((( rutor(u.svarsrutor) )))
((* endmacro *))

((# ══════════ PROVETS EGNA TVÅ FORMER (lärarens förlaga) ══════════ #))

((# exam-klassens frågehuvud, satt som i förlagan: «\question[2] \emph{Endast
    svar krävs.}». Poängen står bara på den uppgift som BÄR dem — har uppgiften
    deluppgifter sitter poängen på a), b), c), och en summa i marginalen
    bredvid numret hade bara varit ett tredje tal att läsa. #))
((* macro fraga(u) *))
\question((* if u.poang_tal and not u.har_deluppgifter *))[((( u.poang_tal )))]((* endif *)) \pfkrav{((( u.krav )))}\par
((* endmacro *))

((# Deluppgiftens huvud: «\part[1]» och texten på nästa rad. Ingen kravetikett
    — den står på uppgiften och gäller alla dess deluppgifter, precis som i
    förlagan. #))
((* macro delfraga(d) *))
\part((* if d.poang_tal *))[((( d.poang_tal )))]((* endif *))
((* endmacro *))

((# Svarsplatsen under ett kortsvar. Ledet före linjen, enheten efter — se
    exam_latex._ar_led. «Svar: ………… x =» stod på ett skarpt prov innan
    skillnaden gjordes: ett likhetstecken efter den tomma linjen. #))
((* macro svarsplats(u) *))
((* if u.led *))\par\svarsradmed{((( u.led )))}{}
((* elif u.enhet *))\par\svarsradmed{}{((( u.enhet )))}
((* else *))\par\svarsrad{Svar:}
((* endif *))
((* endmacro *))

((# De namngivna ifyllnadsraderna. EN RAD PER SVAR — lärarens dom: «Ett svar per
    rad; nästa svar på raden under.» Förlagans \svarsrad saknade \par och lade
    dem bredvid varandra; makrot i _preamble.tex.j2 rättar det, så den här
    makron behöver inte göra något annat än att anropa det en gång per
    etikett. #))
((* macro svarsrader(f) *))
((* if f *))((* for e in f *))\svarsrad{((( e )))}((* endfor *))
((* endif *))
((* endmacro *))

((# Datatabellen i förlagans sättning: booktabs, centrerad, 4 mm luft omkring.
    Skild från `tabell` ovan, som ritar hela rutnätet med \hline och hör till
    arbetsbladen — provet är lärarens förlaga och den har inga lodräta linjer. #))
((* macro tabellbok(t) *))
((* if t *))
\vspace{4mm}
\begin{center}
\begin{tabular}{((( t.spec )))}
  \toprule
((# Ingen fetstil i rubrikraden: förlagans tabell är helt omarkerad, och
    booktabs midrule gör redan skillnaden mellan rubrik och data. Fet rubrik
    hör till arbetsbladens tabell (\tabrubrik), inte till provets. #))
  ((* for r in t.rubriker *))((( r )))((* if not loop.last *)) & ((* endif *))((* endfor *)) \\
  \midrule
((* for rad in t.rader *))
  ((* for c in rad *))((( c )))((* if not loop.last *)) & ((* endif *))((* endfor *)) \\
((* endfor *))
  \bottomrule
\end{tabular}
\end{center}
\vspace{4mm}
((* endif *))
((* endmacro *))

((# Uppgiftstexten som STYCKEN, inte som en klump. Förlagan sätter en formel
    på egen rad centrerad («$h(t) = -5t^2 + 20t + 700$») och bryter
    berättelsen i två stycken där den byter tanke. Modellen skriver samma sak
    med radbrytningar i `text`, och exam_latex delar på dem: en rad som ÄR en
    formel blir en displayformel, övriga blir stycken. #))
((# RADBRYTNINGARNA I DEN HÄR MAKRON ÄR SÄTTNING, INTE FORMATERING. En
    displayformel som klistras direkt efter texten (utan \par) får förlagans
    \abovedisplayskip; ett \par emellan sköt ner den 7,5 pt. Därför står \par
    på egen rad och bara där exam_latex._stycken säger att det ska stå. #))
((* macro stycken(st) *))
((* for s in st *))
((* if s.formel *))
\[ ((( s.text ))) \]
((* if s.par_efter *))\par
((* endif *))
((* else *))
((( s.text )))
((* if s.par_efter *))\par
((* endif *))
((* endif *))
((* endfor *))
((* endmacro *))

