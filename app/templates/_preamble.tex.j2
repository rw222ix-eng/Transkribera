((# Deluppgift: lettrerad (a/b/c) hängande rad inne i uppgift-miljön, med
    egen poängmarkör i högermarginalen. Egen inre lista så bokstaven hänger
    som numret gör på toppnivån. Tomt poängargument → ingen markör. #))
((# Samma delning som uppgiftens gutter, och av samma skäl: «a)Vilket är
    rampens höjdökning» stod på lärarens papper i kväll. 4,5 mm åt markören
    och 2,5 mm åt mellanrummet — 7 mm ihop, alltså oförändrat indrag. #))
((* if forlaga is defined and forlaga *))
((# Förlagans deluppgift: «(a)», högerställd i sin box, poängen i sidans
    spalt. Miljöerna sätts en och en (mallen loopar), så avståndet mellan två
    deluppgifter är \pfdelluft + \parsep = förlagans 13,8 pt över
    radavståndet; luften ner till den FÖRSTA är \pflistluft, alltså exakt ett
    styckeavstånd, precis som i förlagan. #))
\newenvironment{deluppgift}[2]{%
  \par\vspace{\dimexpr\pfdelluft+\pfstyckeluft\relax}%
  \begin{list}{}{%
    \setlength{\leftmargin}{\pfdelindrag}%
    \setlength{\labelwidth}{\pfdeletikett}%
    \setlength{\labelsep}{\pfetikettgap}%
    \setlength{\itemindent}{0pt}%
    \setlength{\listparindent}{0pt}%
    \setlength{\rightmargin}{0pt}%
    \setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}%
    \setlength{\parsep}{\pfstyckeluft}\setlength{\itemsep}{0pt}%
    \renewcommand{\makelabel}[1]{\hfil ##1}}%
  \item[(#1)]\if\relax\detokenize{#2}\relax\else\poang{#2}\fi
  \ignorespaces}%
  {\end{list}}
((* else *))
\newenvironment{deluppgift}[2]{%
  \par\vspace{2.5mm}%
  \begin{list}{}{%
    \setlength{\leftmargin}{7mm}%
    \setlength{\labelwidth}{4.5mm}%
    \setlength{\labelsep}{2.5mm}%
    \setlength{\itemindent}{0pt}%
    \setlength{\listparindent}{0pt}%
    \setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}%
    \setlength{\parsep}{3pt}\setlength{\itemsep}{0pt}}%
  \item[#1)]\if\relax\detokenize{#2}\relax\else\poang{#2}\fi
  \ignorespaces}%
  {\end{list}}
((* endif *))

((# Ett steg i bedömningstrappan (bedomning.tex.j2): NIVÅN FÖRST, i en egen
    smal spalt, och kriteriet i resten av bredden med hängande indrag.

    Formen var först kriteriet till vänster och nivån via \hfill i
    högermarginalen — nationella provets egen sättning, där anvisningen har
    hela sidbredden till kriteriet. Sedan 2026-08-23 står trappan i
    bedömningstabellens HÖGERSPALT, som är 41 % av satsytan, och där räcker
    raden inte till: «deriverar och får $A'(10) = 10$ m$^2$/dygn samt tolkar
    det som hur snabbt algarean växer efter 10 dygn» bröts över fyra rader och
    \hfill sköt «+1 E» till slutet av den sista — mitt inne i textflödet, inte
    i någon marginal. Läraren kunde inte längre läsa av trappan som en trappa.

    Nivån står därför FÖRST och på en fast position, precis som på skärmen
    (app/web/ui/losning.css, .lotrappa: en grid med nivån i första spalten).
    \hangindent + \hangafter=1 drar in rad två och framåt lika mycket som
    \makebox är bred, så kriteriet bildar ett eget block bredvid märket hur
    långt det än är. \mbox skyddar «+1 E» från att brytas. #))
\newlength{\bednivabredd}
\setlength{\bednivabredd}{12.5mm}
\newcommand{\bedsteg}[2]{%
  \par\noindent{\small
    \hangindent=\bednivabredd \hangafter=1
    \makebox[\bednivabredd][l]{\mbox{\textbf{#2}}}#1\par}}

((# Kvadratisk kryssruta för flerval — tom ruta, inget typsnittsberoende
    (bygger på \fbox + \rule, alltid tillgängligt). #))
\newcommand{\kryssruta}{\fbox{\rule{0pt}{1.5ex}\rule{1.5ex}{0pt}}}

((# Svarsraden med led och/eller enhet: «$f'(x) =$ …………» och «………… kr».
    Ledet står FÖRE linjen (det hör till uttrycket), enheten EFTER den (den hör
    till svaret). Utan båda är den vanliga \svarsrad. #))
((* if forlaga is defined and forlaga *))
((# Samma svarsrad som \svarsrad, men med led före linjen och enhet efter:
    «Svar $f'(x) =$ ______» och «Svar: ______ kr». Enheten är appens tillägg —
    förlagan har ingen uppgift som ber om ett svar med enhet — men den sätts i
    samma rad och med samma linje. #))
((# \par som i \svarsrad ovan, och av samma skäl: ett svar per rad. #))
\newcommand{\svarsradmed}[2]{%
  \par\vspace{2mm}%
  \noindent\if\relax\detokenize{#1}\relax Svar:\else Svar #1\fi\ \hrulefill
  \if\relax\detokenize{#2}\relax\else\ #2\fi
  \par\vspace{2mm}}
((* else *))
\newcommand{\svarsradmed}[2]{%
  \par\vspace{4mm}%
  \noindent\if\relax\detokenize{#1}\relax\else#1\ \fi
  \makebox[0.45\linewidth]{\dotfill}%
  \if\relax\detokenize{#2}\relax\else\ #2\fi\par}
((* endif *))

((# Den namngivna ifyllnadsraden: «Ekvation: ………………». Etiketten är fet och står
    före linjen, som går ut i resten av satsytan — samma sättning som
    designdokumentets .gunamn + .gulinje, och samma som lärarens förlaga.
    Skillnaden mot \svarsradmed är att raden HETER något: den ber om ett
    bestämt slags svar, inte om «svaret». #))
((# \hrulefill och inte \rule{...}: linjens längd är «resten av raden», och den
    räknas av TeX själv. \widthof hade krävt paketet calc, och ett paket till i
    preamblen är ett paket till som måste ligga i den buntade Tectonic-cachen. #))
\newcommand{\svarsfaltrad}[1]{%
  \par\vspace{3.5mm}%
  \noindent\makebox[\linewidth]{\textbf{#1:}\enskip\hrulefill}\par}

((# Kryssrutesvar på en rad: «Sats: [] Randvinkelsatsen [] Kordasatsen».
    Rutorna sitter på samma rad som etiketten och bryter som text — en rad
    att fylla i, inte en flervalsfråga. #))
\newcommand{\svarsrutor}[2]{%
  \par\vspace{3mm}\noindent\textbf{#1:}\quad #2\par\vspace{1mm}}
\newcommand{\svarsruteval}[1]{\kryssruta\ #1\hspace{6mm}}

((# Tabellrubrik — i tabeller (datatabell och stegtabell). På skärmen är
    rubrikraden grå (.gutab th, #EDEDED); här är den bara fet. Grå bakgrund i
    en LaTeX-tabell kräver colortbl, och ett paket till i preamblen är ett
    paket till som måste ligga i den buntade Tectonic-cachen — annars kraschar
    kompileringen på lärarens dator, offline, mitt i ett godkännande. Fet
    rubrik läser lika tydligt på papper och kostar ingenting. #))
\newcommand{\tabrubrik}[1]{{\small\bfseries #1}}

((# ══════════ BEDÖMNINGSTABELLENS RAD ══════════
    Lärarens beställning 2026-08-23: vänster lösningen (facit överst, elevernas
    papper därunder), höger poängen och skälet — på SAMMA rad. Läraren läser
    radvis: «så här ser 1 p ut, så här ser 2 p ut», och den jämförelsen är hela
    anvisningens syfte.

    TVÅ MINIPAGES OCH INTE TABULAR. Innehållet är löptext med \par, matte och
    ibland flera rader; en tabellcell hade krävt att varje & och \\ i
    innehållet var oskadliggjort, och det som når hit kommer ur modellen.
    minipage tar vad som helst. Priset är att en rad inte kan brytas över en
    sidbrytning — och det är rätt pris: en halv elevlösning på nästa sida är
    värre än en tom halvsida.

    \newcommand är \long som standard, så argumenten får innehålla \par. #))
\newcommand{\bedrad}[3]{%
  \par\vspace{1.5mm}%
  \noindent{\small\bfseries\textcolor{ink700}{#1}}\par\vspace{0.8mm}%
  \noindent\begin{minipage}[t]{0.55\linewidth}#2\end{minipage}%
  \hfill\begin{minipage}[t]{0.41\linewidth}#3\end{minipage}%
  \par\vspace{1mm}}

((# Skiljelinjen mellan två rader. Står FÖRE varje elevrad och aldrig efter
    den sista — en linje under tabellen hade sett ut som en avstämning. #))
\newcommand{\bedskilj}{%
  \par\vspace{1.5mm}\noindent\textcolor{ink200}{\rule{\linewidth}{0.15mm}}%
  \par\vspace{1.5mm}}

((# Elevlösningens parti — den gamla inramade formen. Används inte längre av
    bedomning.tex.j2 (tabellen ovan ersatte den 2026-08-23) men står kvar:
    preamblen delas av alla fyra mallarna, och att riva ett kommando ur en
    delad preamble för att EN mall slutade använda det är att spara fel sak. #))
\newsavebox{\elevpartibox}
\newenvironment{elevparti}[1]{%
  \par\vspace{2mm}%
  \setlength{\fboxrule}{0.25mm}\setlength{\fboxsep}{2.5mm}%
  \begin{lrbox}{\elevpartibox}%
  \begin{minipage}{\dimexpr\linewidth-2\fboxrule-2\fboxsep\relax}%
  \textbf{#1}\par\vspace{1mm}%
}{%
  \end{minipage}%
  \end{lrbox}%
  \noindent\fcolorbox{ink500}{white}{\usebox{\elevpartibox}}%
  \par\vspace{2mm}}

((# Notis (callout): tunn inramad ruta med \small text under uppgiftstexten. #))
\newcommand{\notisruta}[1]{%
  \par\vspace{2.5mm}%
  \begingroup
  \setlength{\fboxrule}{0.25mm}\setlength{\fboxsep}{2.5mm}%
  \noindent\fcolorbox{ink500}{white}{%
    \begin{minipage}{\dimexpr\linewidth-2\fboxrule-2\fboxsep\relax}%
      {\small #1}\end{minipage}}%
  \endgroup
  \par\vspace{2.5mm}}

((* if forlaga is defined and forlaga *))
((# ══════════ FÖRLAGANS EGNA SÄTTGREPP ══════════ #))

((# Kravetiketten direkt efter numret: «Endast svar krävs.» / «Fullständig
    lösning krävs.» Kursiv, på uppgiftens första rad, i lod med poängen.
    Förlagan skriver den på VARJE uppgift — det är den eleven läser för att
    veta om hon ska skriva svaret på pappret eller lösningen på lösblad. #))
\newcommand{\pfkrav}[1]{\emph{#1}}

((# Ledtråden: kursiv, egen rad, ingen ram. «Tips: Gör en skiss och kalla
    bredden för $x$ cm.» Appens \notisruta ritar en låda runt samma text, och
    en låda mitt i en uppgift läser som ett villkor i stället för som en
    hjälpande hand. #))
\newcommand{\pftips}[1]{\par\emph{#1}\par}

((# Namnraden: fet etikett, linjen ut till satsytans kant — förlagans
    «\noindent\textbf{Namn:} \hrulefill». #))
\newcommand{\pfnamnrad}[1]{\par\noindent\textbf{#1:} \hrulefill\par}

((# Hjälpmedelsradens hängande indrag. Förlagan har två färdiga rader och
    skjuter in den andra med \hphantom{\textbf{Hjälpmedel:}}; appens
    hjälpmedelsregel är EN mening som bryter var den vill, så samma bredd mäts
    upp här och används som \hangindent. Samma indrag, oavsett hur lång
    meningen blir. #))
\newlength{\widthofhjalpmedel}
\settowidth{\widthofhjalpmedel}{\textbf{Hjälpmedel:} }
((* endif *))
