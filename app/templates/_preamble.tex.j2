((# ══════════ FÖRLAGANS MÅTT (mätta i lärarens PDF, punkter) ══════════
    Avlästa ur Ma_2c_prov_i_kapitel_2_Na25.pdf. Namnen säger vad de styr;
    kommentaren efter varje säger var mätningen gjordes. #))
((# Poängspalten: «1 p» börjar på x = 551,8 pt, alltså 27,4 pt UTANFÖR
    satsytans högerkant (524,4 pt). Samma spalt för uppgift och deluppgift —
    poängen är sidans, inte styckets. #))
\newlength{\pfpoangskjut}\setlength{\pfpoangskjut}{27.4pt}
((# Uppgiftens hängande nummer: brödtexten på x = 91,7 (20,8 pt in),
    etikettboxen 14,9 pt bred med 5,9 pt mellanrum — «10.» fyller boxen exakt
    och «1.» står högerställd i den. #))
\newlength{\pfuppgindrag}\setlength{\pfuppgindrag}{20.8pt}
\newlength{\pfuppgetikett}\setlength{\pfuppgetikett}{14.9pt}
((# Deluppgiften: «(a)» högerställd i en 18,8 pt bred box, texten 24,7 pt in
    från uppgiftens text (x = 116,4). #))
\newlength{\pfdelindrag}\setlength{\pfdelindrag}{24.7pt}
\newlength{\pfdeletikett}\setlength{\pfdeletikett}{18.8pt}
\newlength{\pfetikettgap}\setlength{\pfetikettgap}{5.9pt}
((# Uppgift → uppgift mäter 42,1 pt mellan baslinjerna. 14,5 av dem är
    radavståndet självt, resten är listans \itemsep + \parsep. #))
\newlength{\pfuppgluft}\setlength{\pfuppgluft}{22.6pt}
((# Deluppgift → deluppgift mäter 28,3 pt mellan baslinjerna. #))
\newlength{\pfdelluft}\setlength{\pfdelluft}{8.8pt}
((# Stycke → stycke inne i en uppgift mäter 19,4 pt: radavstånd + 5 pt. #))
\newlength{\pfstyckeluft}\setlength{\pfstyckeluft}{5pt}
((# Uppgiftens första rad → första deluppgiften mäter 19,4 pt, alltså exakt
    ett styckeavstånd: listan får samma \topsep som ett stycke. #))
\newlength{\pflistluft}\setlength{\pflistluft}{4.9pt}
((# Svarsraden: 22,6 pt från frågans sista rad ner till «Svar:», och 5,7 pt
    extra under linjen innan nästa deluppgift. #))
\newlength{\pfsvarover}\setlength{\pfsvarover}{8.1pt}
\newlength{\pfsvarunder}\setlength{\pfsvarunder}{5.7pt}

((# Poängen i högermarginalen för de papper som INTE går genom exam-klassens
    \question (bedömningsanvisningen sätter uppgifterna med uppgift-miljön
    nedan och visar poängtripeln E/C/A, som ingen \points kan uttrycka).
    INTE \hfill: med \hfill hamnar poängen sist på den rad den råkar stå på,
    och förlagan har den i en egen spalt utanför satsytan, i lod med
    uppgiftens FÖRSTA rad. #))
\newcommand{\poang}[1]{%
  \makebox[0pt][l]{\hspace{\dimexpr\linewidth+\pfpoangskjut\relax}#1}}
((* if med_svarsrad *))
((# FÖRLAGANS EGET MAKRO, ordagrant. Notera att det saknar \par: två svarsrader
    i rad hamnar därför på SAMMA rad och delar den lediga bredden lika — det är
    så «Svar $p =$ ______  Svar andra lösningen: ______» och «Svar (i): ___
    Svar (ii): ___» blir till. Ett \par här hade brutit isär dem, och det tog
    en mätning i hennes PDF att förstå att det var meningen. #))
\newcommand{\svarsrad}[1]{%
  \vspace{2mm}%
  \noindent #1 \hrulefill%
  \vspace{2mm}%
}
((* endif *))
((* else *))
\newcommand{\poang}[1]{\hfill\mbox{\small(#1)}}
((* if med_svarsrad *))
\newcommand{\svarsrad}{\par\vspace{4mm}\makebox[0.6\linewidth]{Svar: \dotfill}}
((* endif *))
((* endif *))

((# ── Designsystemets layoutprimitiver ──────────────────────────────
    Måtten är px vid 96 dpi omräknade till mm (794 px = 210 mm). #))

((# Delprov-bandet: grafitbar som blöder ut förbi sidmarginalen.
    Systemets starkaste visuella grepp. #))
\newcommand{\delprovband}[1]{%
  \par\vspace{6mm}%
  \noindent\hspace*{-17mm}%
  \colorbox{ink700}{%
    \begin{minipage}{\paperwidth}%
      \vspace{1.2mm}%
      \hspace*{17mm}\textcolor{white}{\bfseries\large #1}%
      \vspace{1.2mm}%
    \end{minipage}}%
  \par\vspace{4mm}}

((# Hängande uppgiftsnummer: numret i 10,5 mm gutter, brödtexten
    indragen. list-miljön klarar flerstyckesinnehåll, vilket en
    \makebox-lösning inte gör. #))
((# GUTTERN ÄR DELAD I TVÅ: brickan får 7,5 mm och mellanrummet 3 mm, och
    tillsammans är de fortfarande 10,5 mm — brödtexten står alltså kvar på
    exakt samma indrag som förut. Här stod labelsep 0pt med labelwidth =
    hela guttern, och LaTeX sätter etiketten HÖGERSTÄLLD i sin box: brickan
    hamnade tätt mot vänsterkanten på texten och satt ihop med den.
    «\textbf{A}Räkna var för sig …», «\textbf{B}I verkstaden …» — läraren
    fick ett papper där bokstaven läste som första bokstaven i meningen.
    Måttet är gutterns, inte ett gap på måfå: \labelsep är det TeX själv
    skjuter in EFTER etikettboxen, så mellanrummet finns även när brickan är
    bredare än sin box (uppgift 10 och framåt). #))
\newlength{\uppgiftgutter}
\setlength{\uppgiftgutter}{10.5mm}
\newlength{\uppgiftbricka}
\setlength{\uppgiftbricka}{7.5mm}
((* if forlaga is defined and forlaga *))
((# Förlagans uppgiftslista. Numret är ROMANT och följt av punkt («1.»,
    «10.») — inte fetstilt som appens bricka; det är en numrerad lista, inte
    en etikett. \makelabel med \hfil framför gör etiketten HÖGERSTÄLLD i sin
    box, vilket är det som gör att ental och tiotal står i lod på förlagan.

    \vspace{0pt} före listan och inte 8,5 mm: avståndet mellan uppgifterna
    bärs av \itemsep, och en fast lucka före varje miljö hade lagts ovanpå
    den. Uppgifterna sätts som separata uppgift-miljöer (mallen är byggd så),
    så luften mellan två uppgifter är \pfuppgluft + \parsep — samma summa som
    en riktig lista hade gett mellan två \item. #))
\newenvironment{uppgift}[2]{%
  \par\vspace{\dimexpr\pfuppgluft+\pfstyckeluft\relax}%
  \begin{list}{}{%
    \setlength{\leftmargin}{\pfuppgindrag}%
    \setlength{\labelwidth}{\pfuppgetikett}%
    \setlength{\labelsep}{\pfetikettgap}%
    \setlength{\itemindent}{0pt}%
    \setlength{\listparindent}{0pt}%
    \setlength{\rightmargin}{0pt}%
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{\pfstyckeluft}%
    \setlength{\itemsep}{0pt}%
    \renewcommand{\makelabel}[1]{\hfil ##1}}%
  \item[#1.]\if\relax\detokenize{#2}\relax\else\poang{#2}\fi
  \ignorespaces}%
  {\end{list}}
((* else *))
\newenvironment{uppgift}[2]{%
  \par\vspace{8.5mm}%
  \begin{list}{}{%
    \setlength{\leftmargin}{\uppgiftgutter}%
    \setlength{\labelwidth}{\uppgiftbricka}%
    \setlength{\labelsep}{\dimexpr\uppgiftgutter-\uppgiftbricka\relax}%
    \setlength{\itemindent}{0pt}%
    \setlength{\listparindent}{0pt}%
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{4pt}%
    \setlength{\itemsep}{0pt}}%
  ((# Tomt poängargument ska ge INGEN markör. \poang{} skulle annars
      skriva ut ett tomt parentespar i marginalen på varje uppgift —
      arbetsbladet döljer poängen när visa_poang är falskt. #))
  \item[\bfseries #1]\if\relax\detokenize{#2}\relax\else\poang{#2}\fi
  \ignorespaces}%
  {\end{list}}
((* endif *))

((# Kvadratisk bläckram, 0,4 mm (1,5 px). Inga rundade hörn — det är papper. #))
\newcommand{\ramruta}[1]{%
  \par\vspace{3mm}%
  \begingroup
  \setlength{\fboxrule}{0.4mm}\setlength{\fboxsep}{3mm}%
  \noindent\fcolorbox{ink900}{white}{%
    \begin{minipage}{\dimexpr\linewidth-2\fboxrule-2\fboxsep\relax}#1\end{minipage}}%
  \endgroup
  \par\vspace{3mm}}

((# Elevrutan från provets försättsblad. #))
\newcommand{\elevruta}{%
  \ramruta{%
    \textbf{Skriv ditt namn, födelsedatum och gymnasieprogram på alla
    papper du lämnar in.}\par\vspace{5mm}%
    Namn: \dotfill\par\vspace{4mm}%
    Födelsedatum: \dotfill\par\vspace{4mm}%
    Gymnasieprogram: \dotfill\par\vspace{1mm}}}

((# Deluppgift: lettrerad (a/b/c) hängande rad inne i uppgift-miljön, med
    egen poängmarkör i högermarginalen. Egen inre lista så bokstaven hänger
    som numret gör på toppnivån. Tomt poängargument → ingen markör. #))
((# Samma delning som uppgiftens gutter, och av samma skäl: «a)Vilket är
    rampens höjdökning» stod på lärarens papper i kväll. 4,5 mm åt markören
    och 2,5 mm åt mellanrummet — 7 mm ihop, alltså oförändrat indrag. #))
((* if forlaga is defined and forlaga *))
((# Förlagans deluppgift: «(a)», högerställd i sin box, poängen i sidans
    spalt. Miljöerna sätts en och en (mallen loopar), så avståndet mellan två
    deluppgifter är \pfdelluft + \parsep = förlagans 13,8 pt över
    radavståndet; luften ner till den FÖRSTA är \pflistluft, alltså exakt ett
    styckeavstånd, precis som i förlagan. #))
\newenvironment{deluppgift}[2]{%
  \par\vspace{\dimexpr\pfdelluft+\pfstyckeluft\relax}%
  \begin{list}{}{%
    \setlength{\leftmargin}{\pfdelindrag}%
    \setlength{\labelwidth}{\pfdeletikett}%
    \setlength{\labelsep}{\pfetikettgap}%
    \setlength{\itemindent}{0pt}%
    \setlength{\listparindent}{0pt}%
    \setlength{\rightmargin}{0pt}%
    \setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}%
    \setlength{\parsep}{\pfstyckeluft}\setlength{\itemsep}{0pt}%
    \renewcommand{\makelabel}[1]{\hfil ##1}}%
  \item[(#1)]\if\relax\detokenize{#2}\relax\else\poang{#2}\fi
  \ignorespaces}%
  {\end{list}}
((* else *))
\newenvironment{deluppgift}[2]{%
  \par\vspace{2.5mm}%
  \begin{list}{}{%
    \setlength{\leftmargin}{7mm}%
    \setlength{\labelwidth}{4.5mm}%
    \setlength{\labelsep}{2.5mm}%
    \setlength{\itemindent}{0pt}%
    \setlength{\listparindent}{0pt}%
    \setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}%
    \setlength{\parsep}{3pt}\setlength{\itemsep}{0pt}}%
  \item[#1)]\if\relax\detokenize{#2}\relax\else\poang{#2}\fi
  \ignorespaces}%
  {\end{list}}
((* endif *))

((# Kvadratisk kryssruta för flerval — tom ruta, inget typsnittsberoende
    (bygger på \fbox + \rule, alltid tillgängligt). #))
\newcommand{\kryssruta}{\fbox{\rule{0pt}{1.5ex}\rule{1.5ex}{0pt}}}

((# Svarsraden med led och/eller enhet: «$f'(x) =$ …………» och «………… kr».
    Ledet står FÖRE linjen (det hör till uttrycket), enheten EFTER den (den hör
    till svaret). Utan båda är den vanliga \svarsrad. #))
((* if forlaga is defined and forlaga *))
((# Samma svarsrad som \svarsrad, men med led före linjen och enhet efter:
    «Svar $f'(x) =$ ______» och «Svar: ______ kr». Enheten är appens tillägg —
    förlagan har ingen uppgift som ber om ett svar med enhet — men den sätts i
    samma rad och med samma linje. #))
\newcommand{\svarsradmed}[2]{%
  \vspace{2mm}%
  \noindent\if\relax\detokenize{#1}\relax Svar:\else Svar #1\fi\ \hrulefill
  \if\relax\detokenize{#2}\relax\else\ #2\fi
  \vspace{2mm}}
((* else *))
\newcommand{\svarsradmed}[2]{%
  \par\vspace{4mm}%
  \noindent\if\relax\detokenize{#1}\relax\else#1\ \fi
  \makebox[0.45\linewidth]{\dotfill}%
  \if\relax\detokenize{#2}\relax\else\ #2\fi\par}
((* endif *))

((# Den namngivna ifyllnadsraden: «Ekvation: ………………». Etiketten är fet och står
    före linjen, som går ut i resten av satsytan — samma sättning som
    designdokumentets .gunamn + .gulinje, och samma som lärarens förlaga.
    Skillnaden mot \svarsradmed är att raden HETER något: den ber om ett
    bestämt slags svar, inte om «svaret». #))
((# \hrulefill och inte \rule{...}: linjens längd är «resten av raden», och den
    räknas av TeX själv. \widthof hade krävt paketet calc, och ett paket till i
    preamblen är ett paket till som måste ligga i den buntade Tectonic-cachen. #))
\newcommand{\svarsfaltrad}[1]{%
  \par\vspace{3.5mm}%
  \noindent\makebox[\linewidth]{\textbf{#1:}\enskip\hrulefill}\par}

((# Kryssrutesvar på en rad: «Sats: [] Randvinkelsatsen [] Kordasatsen».
    Rutorna sitter på samma rad som etiketten och bryter som text — en rad
    att fylla i, inte en flervalsfråga. #))
\newcommand{\svarsrutor}[2]{%
  \par\vspace{3mm}\noindent\textbf{#1:}\quad #2\par\vspace{1mm}}
\newcommand{\svarsruteval}[1]{\kryssruta\ #1\hspace{6mm}}

((# Tabellrubrik — i tabeller (datatabell och stegtabell). På skärmen är
    rubrikraden grå (.gutab th, #EDEDED); här är den bara fet. Grå bakgrund i
    en LaTeX-tabell kräver colortbl, och ett paket till i preamblen är ett
    paket till som måste ligga i den buntade Tectonic-cachen — annars kraschar
    kompileringen på lärarens dator, offline, mitt i ett godkännande. Fet
    rubrik läser lika tydligt på papper och kostar ingenting. #))
\newcommand{\tabrubrik}[1]{{\small\bfseries #1}}

((# Elevlösningens parti i bedömningsanvisningen: lösningens egna rader, och
    domen inne i partiet den gäller — inte i en lista under. #))
\newsavebox{\elevpartibox}
\newenvironment{elevparti}[1]{%
  \par\vspace{2mm}%
  \setlength{\fboxrule}{0.25mm}\setlength{\fboxsep}{2.5mm}%
  \begin{lrbox}{\elevpartibox}%
  \begin{minipage}{\dimexpr\linewidth-2\fboxrule-2\fboxsep\relax}%
  \textbf{#1}\par\vspace{1mm}%
}{%
  \end{minipage}%
  \end{lrbox}%
  \noindent\fcolorbox{ink500}{white}{\usebox{\elevpartibox}}%
  \par\vspace{2mm}}

((# Notis (callout): tunn inramad ruta med \small text under uppgiftstexten. #))
\newcommand{\notisruta}[1]{%
  \par\vspace{2.5mm}%
  \begingroup
  \setlength{\fboxrule}{0.25mm}\setlength{\fboxsep}{2.5mm}%
  \noindent\fcolorbox{ink500}{white}{%
    \begin{minipage}{\dimexpr\linewidth-2\fboxrule-2\fboxsep\relax}%
      {\small #1}\end{minipage}}%
  \endgroup
  \par\vspace{2.5mm}}

((* if forlaga is defined and forlaga *))
((# ══════════ FÖRLAGANS EGNA SÄTTGREPP ══════════ #))

((# Kravetiketten direkt efter numret: «Endast svar krävs.» / «Fullständig
    lösning krävs.» Kursiv, på uppgiftens första rad, i lod med poängen.
    Förlagan skriver den på VARJE uppgift — det är den eleven läser för att
    veta om hon ska skriva svaret på pappret eller lösningen på lösblad. #))
\newcommand{\pfkrav}[1]{\emph{#1}}

((# Ledtråden: kursiv, egen rad, ingen ram. «Tips: Gör en skiss och kalla
    bredden för $x$ cm.» Appens \notisruta ritar en låda runt samma text, och
    en låda mitt i en uppgift läser som ett villkor i stället för som en
    hjälpande hand. #))
\newcommand{\pftips}[1]{\par\emph{#1}\par}

((# Namnraden: fet etikett, linjen ut till satsytans kant — förlagans
    «\noindent\textbf{Namn:} \hrulefill». #))
\newcommand{\pfnamnrad}[1]{\par\noindent\textbf{#1:} \hrulefill\par}

((# Hjälpmedelsradens hängande indrag. Förlagan har två färdiga rader och
    skjuter in den andra med \hphantom{\textbf{Hjälpmedel:}}; appens
    hjälpmedelsregel är EN mening som bryter var den vill, så samma bredd mäts
    upp här och används som \hangindent. Samma indrag, oavsett hur lång
    meningen blir. #))
\newlength{\widthofhjalpmedel}
\settowidth{\widthofhjalpmedel}{\textbf{Hjälpmedel:} }
((* endif *))
