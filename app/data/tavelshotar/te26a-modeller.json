         "kind": "math",
         "latex": "t = 20 \\text{ ger } K = 70",
         "size": 22,
         "gapAfter": 2
        },
        {
         "kind": "text",
         "text": "Rimligt: 70 kr för 20 min.",
         "size": 18,
         "gapAfter": 10
