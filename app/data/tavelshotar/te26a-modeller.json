         "weight": 700,
         "gapAfter": 8
        },
        {
         "kind": "math",
         "latex": "W = \\frac{m \\cdot v^2}{2}",
         "size": 26,
         "gapAfter": 6
        },
        {
         "kind": "text",
         "text": "Den har variabler.",
         "size": 18,
