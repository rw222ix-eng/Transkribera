      {
       "kind": "heading",
       "text": "Exempel: elsparkcykelns batteri",
       "size": 28,
       "underline": {},
       "gapAfter": 14
      },
      {
       "kind": "math",
       "latex": "B = \\text{batteri kvar i \\%}",
       "size": 20,
       "gapAfter": 4
      },
      {
       "kind": "math",
       "latex": "x = \\text{körda km}",
       "size": 20,
       "gapAfter": 14
      },
      {
       "kind": "text",
       "text": "E-nivå",
       "size": 20,
       "weight": 700,
       "color": "blue",
       "gapAfter": 8
      },
      {
       "kind": "text",
       "text": "a) Batteriet är fullt, 100 %.",
       "size": 20,
       "gapAfter": 4
      },
      {
       "kind": "text",
       "text": "Varje km drar 6 %.",
       "size": 20,
       "gapAfter": 4
      },
      {
       "kind": "text",
       "text": "Skriv en formel för det som är kvar.",
       "size": 20,
       "gapAfter": 12
      },
      {
       "kind": "math",
       "latex": "x \\text{ km drar } 6x \\text{ \\%}",
       "size": 22,
       "gapAfter": 8
      },
      {
       "kind": "math",
       "latex": "B = 100 - 6x",
       "size": 22,
       "gapAfter": 8
      },
      {
       "kind": "math",
       "latex": "x = 5 \\text{ ger } B = 70",
       "size": 22,
       "gapAfter": 8
      },
      {
       "kind": "math",
       "latex": "\\text{Svar: } B = 100 - 6x",
       "size": 22
      }
     ]
    },
    {
     "weight": 1,
     "sections": [
      {
       "kind": "text",
       "text": "C-nivå",
       "size": 20,
       "weight": 700,
       "color": "blue",
       "gapAfter": 6
      },
      {
       "kind": "text",
       "text": "b) Hur långt räcker batteriet?",
       "size": 20,
       "gapAfter": 8
      },
      {
       "kind": "math",
       "latex": "100 - 6x = 0",
       "size": 20,
       "gapAfter": 5
      },
      {
       "kind": "math",
       "latex": "6x = 100",
       "size": 20,
       "gapAfter": 5
      },
      {
       "kind": "math",
       "latex": "x \\approx 16{,}7",
       "size": 20,
       "gapAfter": 5
      },
      {
       "kind": "math",
       "latex": "x = 16 \\text{ ger } B = 4",
       "size": 20,
       "gapAfter": 5
      },
      {
       "kind": "math",
       "latex": "x = 17 \\text{ ger } B = -2",
       "size": 20,
       "gapAfter": 5
      },
      {
       "kind": "math",
       "latex": "\\text{Gäller för } 0 \\leq x \\leq 16{,}7",
       "size": 20,
       "gapAfter": 5
      },
      {
       "kind": "math",
       "latex": "\\text{Svar: knappt } 17 \\text{ km}",
       "size": 20,
       "gapAfter": 0
      }
     ]
    },
    {
     "weight": 1,
     "sections": [
      {
       "kind": "text",
       "text": "A-nivå",
       "size": 20,
       "weight": 700,
       "color": "blue",
       "gapAfter": 8
      },
      {
       "kind": "text",
       "text": "c) Cykel 2 har 80 % batteri.",
       "size": 20,
       "gapAfter": 4
      },
      {
       "kind": "text",
       "text": "Den drar 4 % per km.",
       "size": 20,
       "gapAfter": 4
      },
      {
       "kind": "text",
       "text": "Båda kör lika långt.",
       "size": 20,
       "gapAfter": 4
      },
      {
       "kind": "text",
       "text": "När har de lika mycket kvar?",
       "size": 20,
       "gapAfter": 12
      },
      {
       "kind": "math",
       "latex": "\\text{Cykel 1: } B = 100 - 6x",
       "size": 22,
       "gapAfter": 8
      },
      {
       "kind": "math",
       "latex": "\\text{Cykel 2: } B = 80 - 4x",
       "size": 22,
       "gapAfter": 8
      },
      {
       "kind": "math",
       "latex": "100 - 6x = 80 - 4x",
       "size": 22,
       "gapAfter": 8
      },
      {
       "kind": "math",
       "latex": "20 = 2x",
       "size": 22,
       "gapAfter": 8
      },
      {
       "kind": "math",
       "latex": "x = 10 \\text{ ger båda } B = 40",
       "size": 22,
       "gapAfter": 8
      },
      {
       "kind": "math",
       "latex": "\\text{Svar: efter 10 km}",
       "size": 22,
       "gapAfter": 8
      },
      {
       "kind": "math",
       "latex": "\\text{Under 10 km: cykel 1 har mest}",
       "size": 22,
       "gapAfter": 8
      },
      {
       "kind": "math",
       "latex": "\\text{Över 10 km: cykel 2 har mest}",
       "size": 22
      }
     ]
