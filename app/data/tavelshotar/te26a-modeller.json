         "gapAfter": 8
        },
        {
         "kind": "text",
         "text": "Hyra en elsparkcykel:",
         "size": 18,
         "gapAfter": 4
        },
        {
         "kind": "text",
         "text": "10 kr i start, 3 kr per minut.",
         "size": 18,
         "gapAfter": 6
        },
        {
         "kind": "math",
         "latex": "K = 10 + 3t",
         "size": 30,
         "gapAfter": 6
        },
        {
         "kind": "text",
         "text": "K: kostnad i kr, t: minuter",
         "size": 18,
         "gapAfter": 4
        },
        {
         "kind": "text",
         "text": "Vi bygger sambandet själva.",
         "size": 18,
         "gapAfter": 4
        },
        {
         "kind": "text",
         "text": "Den gäller bara inom gränser.",
         "size": 18,
         "gapAfter": 22
