{"title": "Andragradsekvationer", "boards": [{"width": 900, "height": 780, "padding": {"top": 30, "right": 30, "bottom": 30, "left": 40}, "chrome": "aluminium", "tray": true, "name": "vanster", "sections": [{"kind": "text", "text": "08:10–09:40", "size": 16, "color": "black", "gapAfter": 10}, {"kind": "heading", "text": "Andragradsekvationer", "size": 32, "align": "center", "underline": {"amplitude": 2, "thickness": 3, "reserve": 14}, "gapAfter": 14}, {"kind": "list", "bullet": "–", "size": 19, "gap": 4, "indent": 22, "align": "center", "items": ["Vad två rötter betyder", "Lösa ekvationer med kvadrater", "Boken s. 39–41, uppg. 1301–1308, 1310–1315"], "gapAfter": 12}, {"kind": "divider", "width": 620, "gapAfter": 14}, {"kind": "heading", "text": "Vad är en andragradsekvation?", "size": 22, "gapAfter": 14}, {"kind": "row", "gap": 24, "children": [{"kind": "col", "width": 400, "gap": 6, "children": [{"kind": "text", "text": "1. Vad är det?", "size": 18, "weight": 700, "gapAfter": 8}, {"kind": "text", "text": "Ekvation där det obekanta talet är kvadrerat.", "size": 18, "gapAfter": 12}, {"kind": "math", "latex": "x^2 = a", "size": 28, "gapAfter": 4}, {"kind": "text", "text": "kvadrat, obekant, högerled", "size": 17, "gapAfter": 12}, {"kind": "text", "text": "Kvadratrot: positivt tal eller noll", "size": 18}, {"kind": "text", "text": "Rot: lösning, kan vara två", "size": 18, "gapAfter": 12}, {"kind": "math", "latex": "x^2 = 64 \\Rightarrow x = \\pm 8", "size": 20, "gapAfter": 2}, {"kind": "text", "text": "Båda ger 64 i kvadrat.", "size": 16, "gapAfter": 6}, {"kind": "math", "latex": "\\Downarrow", "size": 16, "gapAfter": 6}, {"kind": "math", "latex": "x^2 = a \\Rightarrow x = \\pm\\sqrt{a}", "size": 24}]}, {"kind": "col", "width": 400, "gap": 6, "children": [{"kind": "text", "text": "2. Så löser vi", "size": 18, "weight": 700, "gapAfter": 8}, {"kind": "list", "bullet": "–", "size": 17, "gap": 6, "indent": 18, "items": ["Samla: kvadraten ensam i ledet", "Dela: med talet framför kvadraten", "Dra roten: både plus och minus"], "gapAfter": 16}, {"kind": "text", "text": "3. Att tänka på", "size": 18, "weight": 700, "gapAfter": 8}, {"kind": "math", "latex": "x^2 = -20", "size": 20, "gapAfter": 2}, {"kind": "text", "text": "En kvadrat blir aldrig negativ.", "size": 16, "gapAfter": 10}, {"kind": "math", "latex": "x^2 = 0 \\Rightarrow x = 0", "size": 20, "gapAfter": 2}, {"kind": "text", "text": "Noll ger bara en rot.", "size": 16, "gapAfter": 10}, {"kind": "math", "latex": "x = \\pm\\sqrt{14} \\approx \\pm 3{,}7", "size": 20, "gapAfter": 2}, {"kind": "text", "text": "Exakt svar om inget annat sägs.", "size": 16, "gapAfter": 6}]}]}]}, {"width": 1800, "height": 780, "padding": {"top": 30, "right": 30, "bottom": 30, "left": 30}, "chrome": "aluminium", "tray": true, "name": "hoger", "columns": [{"weight": 1, "sections": [{"kind": "heading", "text": "Exempel 1", "size": 28, "underline": {}, "gapAfter": 12}, {"kind": "text", "text": "En sten faller. Efter t sekunder har den fallit:", "size": 20, "gapAfter": 10}, {"kind": "math", "latex": "s = 5t^2", "size": 26, "gapAfter": 12}, {"kind": "col", "width": 740, "gap": 8, "children": [{"kind": "text", "text": "Hur lång tid tar det att falla 45 m?", "size": 20}, {"kind": "math", "latex": "5t^2 = 45", "size": 26, "gapAfter": 12}]}, {"kind": "list", "bullet": "–", "size": 19, "gap": 6, "items": ["Sätt in: sträckan 45 meter", "Dra roten: negativ tid finns inte"], "gapAfter": 26}, {"kind": "heading", "text": "Exempel 2: svaret blir en rot", "size": 26, "underline": {}, "gapAfter": 12}, {"kind": "text", "text": "Samma fall, nu 100 m.", "size": 20, "gapAfter": 12}, {"kind": "math", "latex": "5t^2 = 100", "size": 26, "gapAfter": 16}, {"kind": "list", "bullet": "–", "size": 19, "gap": 6, "items": ["Dela: båda leden med 5", "Dra roten: ur 20, rotmärket kvar"]}]}, {"weight": 1, "sections": [{"kind": "heading", "text": "Exempel 3: kvadraten i en parentes", "size": 26, "underline": {}, "gapAfter": 12}, {"kind": "text", "text": "Nu står hela parentesen i kvadrat.", "size": 20, "gapAfter": 12}, {"kind": "math", "latex": "(x + 4)^2 = 25", "size": 26, "gapAfter": 16}, {"kind": "list", "bullet": "–", "size": 19, "gap": 6, "items": ["Dra roten: ur hela parentesen", "Lös ut: x i båda fallen"], "gapAfter": 24}, {"kind": "math", "latex": "x + 4 = \\pm 5", "size": 24, "gapAfter": 8}, {"kind": "math", "latex": "x + 4 = 5", "size": 24, "color": "red", "gapAfter": 8}, {"kind": "text", "text": "Den röda raden tappar den andra roten.", "size": 18}]}]}]}