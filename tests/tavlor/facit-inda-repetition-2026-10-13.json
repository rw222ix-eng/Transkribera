weight": 700, "color": "blue", "gapAfter": 8}, {"kind": "text", "text": "d) Lös x² − 2x − 15 = 0.", "size": 21, "gapAfter": 4}, {"kind": "text", "text": "Utan räknare", "size": 18, "weight": 700, "color": "black", "gapAfter": 8}, {"kind": "math", "latex": "x = 1 \\pm \\sqrt{1 + 15} = 1 \\pm 4", "size": 22, "gapAfter": 6}, {"kind": "math", "latex": "\\text{Svar: } x_1 = 5,\\ x_2 = -3", "size": 22, "gapAfter": 0}]}, {"weight": 1, "sections": [{"kind": "text", "text": "A-nivå", "size": 20, "weight": 700, "color": "blue", "gapAfter": 8}, {"kind": "text", "text": "e) Bestäm k så att", "size": 21, "gapAfter": 3}, {"kind": "text", "text": "x² + 10x + k = 0", "size": 21, "gapAfter": 3}, {"kind": "text", "text": "har exakt en lösning.", "size": 21, "gapAfter": 4}, {"kind": "text", "text": "Utan räknare", "size": 18, "weight": 700, "color": "black", "gapAfter": 8}, {"kind": "math", "latex": "x = -5 \\pm \\sqrt{25 - k}", "size": 22, "gapAfter": 6}, {"kind": "text", "text": "En lösning: roten är 0", "size": 19, "gapAfter": 6}, {"kind": "math", "latex": "\\text{Svar: } k = 25", "size": 22, "gapAfter": 0}]}]}]}