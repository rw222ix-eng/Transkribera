# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Känsligt — får ALDRIG checkas in
cookies.txt
google_client_secret.json
google_token.json
openai_key.txt
elevenlabs_key.txt

# Runtime-data (skapas bredvid exe:n)
history.json
transkribera.db
transkribera.db-wal
transkribera.db-shm

# Nedladdade modeller / cache
models/
*.bin
*.gguf

# Media (in- och utdata)
*.wav
*.mp3
*.m4a
*.mkv
*.mp4
*.webm
*.png
# Ikonernas källbilder är undantagna: utan dem går .ico-filerna inte att bygga om.
!assets/*.png
# Frontendens egna bilder likaså. `*.png` är till för lärarens media, men den
# svalde också appens bakgrund: molnen låg på utvecklarens disk och INTE i
# repot, så varje klon — och varje CI-körning — fick en app som svarade 404 på
# sin egen bakgrund. Det var det som fällde apans konsolvakt i CI.
!app/web/ui/assets/**/*.png

# Genererade transkript
*.srt
*.vtt
*.ord.json

# Studions inspelningar: en mapp per avsnitt med ljudet, manuset och tiderna.
# Lärarens eget material — hör hemma på disken, aldrig i repot.
Manus/

# Diverse
nul
*.log

# PyInstaller
/build/
/dist/
*.manifest

# llama.cpp-binärer + spike-artefakter (stora; byggs/laddas separat)
/bin/llamacpp/
/bin/tectonic/
/_spike/

# Lokala Claude Code-inställningar
.claude/

# Worktrees
/.worktrees/

# Playwright e2e
e2e/node_modules/
e2e/.test-data/
e2e/.test-data-real/
e2e/.test-data-preview/
e2e/.test-data-qa/
e2e/test-results/
e2e/_srv_*.txt

# Impeccable live mode (durabel sessionsjournal — lokal återhämtning, ej projektkälla)
.impeccable/live/sessions/
e2e/playwright-report/
e2e/.cache/
e2e/visual-screens/

# Genererad verifieringsbild för app-snapshot (ej versionshanterad)
design-system/_snapshot-verify.png

# Genererade ljudtestfiler (skapas av tests/download_sv_audio.py)
tests/audio_samples/

# Whiteboard-benchens körningsartefakter (tests/bench_whiteboard.py)
tests/bench_out/

# Lokala QA-körningsartefakter (rådata från riktiga transkriberingskörningar)
exports/

# Användarens transkriberingar och exporterade dokument (lokal elevdata — får ALDRIG checkas in)
/Transkriberingar/

# Nedladdad föreläsningsmedia och lösa transkript i repo-roten (lokal lektionsdata
# — får ALDRIG checkas in). Själva medie- och undertextfilerna är redan täckta
# globalt ovan (*.mkv/*.mp4/*.webm rad 28-30, *.srt/*.vtt rad 34-35); det som
# saknade täckning var .txt-transkripten och yt-dlp:s sidofiler (.info.json,
# .description, miniatyrer), som reglerna nedan fångar.
/downloads/
/Mamma waw isolerad.txt

# Byggd Svelte-frontend (byggs vid paketering, checkas inte in)
app/web/next/
node_modules/

# OCR-utvärderingen: läroboksidor och modellutdata checkas aldrig in.
# Riggen (kor.py, jamfor.py, adaptrar.py, prompt.py, README.md) gör det.
ocr-eval/sidor/
ocr-eval/resultat/
ocr-eval/.nycklar
# claude-code-fil låter agenten skriva avläsningen hit i stället för att svara
# i chatten; adaptern läser tillbaka filen. Samma boksidesinnehåll som resultat/.
ocr-eval/.tmp/

# Playwrights körartefakter (skapas i repo-roten om sviten körs därifrån)
test-results/

# Coverage (CI laddar upp den som artefakt; lokalt är den skräp)
.coverage
coverage.xml
htmlcov/

# Playwright-spår från soakvarv som föll (tools/soak.py)
soak-fall/
